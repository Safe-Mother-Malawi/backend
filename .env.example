# Application
PORT=3001
NODE_ENV=development

# Database - Use DATABASE_URL for both local and production
# Local development: postgresql://postgres:password@localhost:5432/safemothermalawi
# Production (Render): Get from Render PostgreSQL Internal Database URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/safemothermalawi

# JWT
JWT_ACCESS_SECRET=smm_access_secret_change_in_production
JWT_REFRESH_SECRET=smm_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Safe Mother Malawi

# URLs
PUBLIC_URL=https://your-ngrok-url.ngrok-free.dev
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
