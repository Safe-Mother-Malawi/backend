# Firebase Configuration for Push Notifications
# Copy this file to .env and fill in your Firebase credentials

# Firebase Service Account (JSON string)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then convert the JSON to a single-line string
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"safe-mother-malawi","private_key_id":"your_key_id","private_key":"-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@safe-mother-malawi.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40safe-mother-malawi.iam.gserviceaccount.com"}'

# Optional: Firebase Database URL
# FIREBASE_DATABASE_URL=https://safe-mother-malawi.firebaseio.com

# Optional: Firebase Storage Bucket
# FIREBASE_STORAGE_BUCKET=safe-mother-malawi.appspot.com

# Node Environment
NODE_ENV=development

# Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/safe_mother_malawi

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# JWT Expiration
JWT_EXPIRATION=24h

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# App Configuration
APP_NAME=Safe Mother Malawi
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Logging
LOG_LEVEL=debug
